# ============================================================================
#  复制成 .env 再填值;.env 已在 .gitignore 里,不要提交。
#  不要把真实密钥写进 README / 镜像 / 日志。
# ============================================================================

# ---- 登录(必填)----
# 推荐:BCrypt 哈希;生成方式见 docs/deploy.md
# 注意:Compose 的 env_file 会做变量插值,哈希里的 $ 需要写成 $$,
# 或者直接用 FA_AUTH_PASSWORD(仅本地/首次部署,启动时编码进内存,不落盘)。
FA_AUTH_USERNAME=pengge
FA_AUTH_PASSWORD_HASH=
# 二选一;留空会启动失败,避免默认口令上线
FA_AUTH_PASSWORD=

# ---- 管理接口(强烈建议设置)----
# 不设置时入库接口只靠登录保护;公网部署必须设置
FA_ADMIN_KEY=

# ---- 模型密钥(按需)----
FA_DEEPSEEK_API_KEY=
FA_VISION_API_KEY=
# 视觉厂商 profile 示例:Kimi / Qwen 等,详见 application.yml

# ---- embedding ----
# 外部向量:填服务根地址(客户端会拼 /v1/embeddings;不要带 /v1/embeddings)
FA_EMBEDDING_URL=https://your-embedding-host.example
# 同机本地模型:用 docker-compose.local-embedding.yml 覆盖为 http://embedding:8090
FA_EMBEDDING_MODEL=bge-m3
FA_EMBEDDING_API_KEY=
FA_EMBEDDING_HEALTH_PATH=/health
FA_EMBEDDING_TIMEOUT_SECONDS=20

# ---- 资源边界(按机器调整;2C4G 起步,4C8G 更稳)----
FA_STREAM_WORKERS=4
FA_STREAM_QUEUE=8
FA_STREAM_IDLE_TIMEOUT_SECONDS=60
FA_STREAM_TOTAL_TIMEOUT_SECONDS=300
FA_MODEL_MAX_CONCURRENT=2
FA_MODEL_BACKGROUND_CONCURRENT=1
FA_MODEL_ACQUIRE_TIMEOUT_SECONDS=10
# ---- 安全 ----
# 只信任这些内网代理转发的 X-Forwarded-*;公网直连伪造的头会被忽略
FA_TRUSTED_PROXY_REGEX=10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\..*|172\.(1[6-9]|2\d|3[01])\..*|127\.0\.0\.1|::1
FA_RATE_LIMIT_PER_MINUTE=12
APP_MEM_LIMIT=2g
EMBEDDING_MEM_LIMIT=3g

# ---- 会话 Cookie:HTTPS 正式部署改成 true ----
FA_COOKIE_SECURE=false

# ---- 时区 ----
TZ=Asia/Shanghai
