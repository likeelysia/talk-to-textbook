<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========== 父工程:Spring Boot 统一管版本/插件(BOM 一网打尽) ========== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- ========== 坐标:项目的全球唯一标识 ========== -->
    <groupId>io.github.likeelysia</groupId>
    <artifactId>talk-to-textbook</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <!-- ========== 门面信息:开源项目必备 ========== -->
    <name>Talk to Textbook</name>
    <description>My first open-source AI Agent project. 我的第一个开源 AI Agent 项目。</description>
    <url>https://github.com/likeelysia/talk-to-textbook</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>likeelysia</id>
            <name>likeelysia</name>
            <email>likeelysia@users.noreply.github.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/likeelysia/talk-to-textbook.git</connection>
        <developerConnection>scm:git:git@github.com:likeelysia/talk-to-textbook.git</developerConnection>
        <url>https://github.com/likeelysia/talk-to-textbook</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/likeelysia/talk-to-textbook/issues</url>
    </issueManagement>

    <!-- ========== 编译参数(Boot 父工程据此设置编译 release) ========== -->
    <properties>
        <java.version>17</java.version>
        <!-- 本地 OCR(RapidOCR):Boot BOM 不管,自己写版本 -->
        <rapidocr.version>0.0.7</rapidocr.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- ========== 依赖:版本基本交给 Boot BOM,只有 BOM 没管的才写版本 ========== -->
    <dependencies>
        <!-- Boot 核心:自动配置 + 内嵌容器 + 日志(SLF4J/Logback)+ spring-context -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Web:内嵌 Tomcat + Spring MVC(@RestController / @PostMapping ...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 重试(AOP 切面式) -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <!-- @EnableRetry 注解式重试需要 aspectj 支持 -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- PDF 解析(Boot BOM 不管,自己写版本) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>

        <!-- 本地 OCR:RapidOCR(纯 Java 调 onnxruntime,PP-OCRv4 中文模型,CPU 跑,离线) -->
        <!-- 核心库;slf4j-api 排除掉,用 Spring Boot 自带的那份,免得版本打架 -->
        <dependency>
            <groupId>io.github.mymonstercat</groupId>
            <artifactId>rapidocr</artifactId>
            <version>${rapidocr.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 平台适配包:按当前系统自动带 native 库 + 模型(windows-x86_64 走 onnx) -->
        <dependency>
            <groupId>io.github.mymonstercat</groupId>
            <artifactId>rapidocr-onnx-platform</artifactId>
            <version>${rapidocr.version}</version>
        </dependency>

        <!-- 背词工具:SQLite 词典(ECDICT 340 万词条) + Word 导出 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
        <!-- POI 用 log4j-api 记日志;桥接到 Spring 的 Logback,避免“无 binding”警告 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-to-slf4j</artifactId>
        </dependency>

        <!-- 测试:JUnit 5 + AssertJ + Mockito + spring-test 全家桶 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ========== 构建插件:打"可执行 jar" ========== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
